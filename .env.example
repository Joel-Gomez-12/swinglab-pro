# ---- Frontend (Vite exposes only VITE_* vars to the browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Stripe publishable key (safe in the browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# The URL your app is served from (used for Stripe redirect back)
VITE_SITE_URL=http://localhost:5173

# ---- Netlify serverless functions ONLY (never exposed to browser) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# The Stripe Price ID for the 50€ founder plan
STRIPE_PRICE_ID=price_xxx
# Supabase service_role key — server side only, full access
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
